# OAuth service
PORT=8777
API_BASE_URL=https://oauth.example.com
# Use a strong random secret, shared across instances so signed OAuth state validates at callback.
SOCIAL_STATE_SECRET=replace-with-long-random-secret

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must be registered as an authorized redirect URI in Google Cloud Console.
CHATAPP_YOUTUBE_REDIRECT_URI=https://oauth.example.com/chatapp/connect/youtube/callback

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CHATAPP_GITHUB_REDIRECT_URI=https://oauth.example.com/chatapp/connect/github/callback

# Facebook OAuth App
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
CHATAPP_FACEBOOK_REDIRECT_URI=https://oauth.example.com/chatapp/connect/facebook/callback

# X / Twitter OAuth 2.0 app: use read-only scopes (no tweet.write or offline.access).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_SCOPES=tweet.read users.read
CHATAPP_X_REDIRECT_URI=https://oauth.example.com/chatapp/connect/x/callback

# LinkedIn OAuth app with the Sign In with LinkedIn using OpenID Connect product enabled.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
CHATAPP_LINKEDIN_REDIRECT_URI=https://oauth.example.com/chatapp/connect/linkedin/callback
